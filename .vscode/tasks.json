{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tests: suite completa",
      "type": "shell",
      "command": ".venv/bin/python tests/_runner.py --jobs 4",
      "windows": { "command": ".venv\\Scripts\\python tests\\_runner.py --jobs 4" },
      "options": { "env": { "QT_QPA_PLATFORM": "offscreen" } },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Tests: selección",
      "type": "shell",
      "command": ".venv/bin/python tests/_runner.py ${input:patronDeTests}",
      "windows": { "command": ".venv\\Scripts\\python tests\\_runner.py ${input:patronDeTests}" },
      "options": { "env": { "QT_QPA_PLATFORM": "offscreen" } },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Abrir OGR Slip2D",
      "type": "shell",
      "command": ".venv/bin/python -m ogr_gui",
      "windows": { "command": ".venv\\Scripts\\python -m ogr_gui" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "patronDeTests",
      "type": "promptString",
      "description": "Fragmento del nombre de archivo (p. ej. transient)",
      "default": ""
    }
  ]
}
