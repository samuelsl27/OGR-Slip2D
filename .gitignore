# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# IDE / editor
# The three shared VSCode files DO travel: docs/EMPEZAR_EN_VSCODE.md promises
# the "Tests: suite completa" task and the recommended extensions, and that
# promise only holds if they reach whoever clones the repository.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*.sublime-*

# OS
.DS_Store
Thumbs.db

# Project outputs / user files
*.ogr
*.h5
!examples/*.ogr
!examples/*.h5
# v0.1.78 — validation case models ARE versioned. validacion/README.md has
# said so since the directory was created ("Va aquí (se versiona): el modelo
# .ogr"), but the blanket *.ogr rule above silently excluded them, and a
# case without its model is SKIPPED rather than failed — so a fresh clone
# would have gone quietly back to zero runnable cases.
# The .h5 results next to them stay ignored: they are output, not input.
!validacion/casos/**/*.ogr
quick_slope_results.h5

# Jupyter
.ipynb_checkpoints/

# Logs
*.log
.claude/settings.local.json
# Material de terceros: no se redistribuye. El patrón lleva `/*` y no
# `/` final a propósito — con la barra final Git no desciende al
# directorio y la excepción de abajo sería inalcanzable.
docs/reference/*
# El README sí se publica: es texto propio y explica al que clone por qué
# la carpeta llega vacía. Un test lo comprueba, y sin versionarlo ese test
# solo podía pasar en la máquina del autor.
!docs/reference/README.md
